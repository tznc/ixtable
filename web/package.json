{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --port 3001",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:web-qa": "playwright test e2e/web-qa.spec.ts",
    "service-qa": "playwright test --config playwright.service-qa.config.ts",
    "service-qa:up": "node ../scripts/cloud/up.mjs",
    "service-qa:deno": "node ../scripts/cloud/deno-test.mjs",
    "service-qa:contracts": "playwright test --config playwright.service-qa.config.ts --project=contracts",
    "service-qa:ui": "playwright test --config playwright.service-qa.config.ts --project=ui",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:ast": "cd .. && ast-grep scan web --warning",
    "lint": "oxlint . && eslint . && npm run lint:ast"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@mdx-js/react": "^3.0.0",
    "@supabase/supabase-js": "^2.108.2",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.38.7",
    "@biomejs/biome": "2.5.8",
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@eslint/js": "10.0.1",
    "@noble/ciphers": "^2.4.0",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.0.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "oxlint": "1.78.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.67.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
