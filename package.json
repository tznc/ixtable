{
  "name": "ixtable",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "node scripts/release/icons.mjs generate",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "pretest": "node scripts/ci/build-test-bridge.mjs",
    "test": "vitest run --passWithNoTests && npm run test:integration:run",
    "test:integration:run": "vitest run --config vitest.integration.config.ts",
    "pretest:integration": "npm run pretest",
    "test:integration": "npm run test:integration:run",
    "screenshot:css": "npm run build && node scripts/screenshot/build-css.mjs",
    "prescreenshot": "npm run pretest",
    "screenshot": "npm run screenshot:css && npm run screenshot:clean && vitest run --config vitest.screenshot.config.ts && npm run screenshot:docs",
    "screenshot:clean": "node scripts/screenshot/clean.mjs",
    "screenshot:docs": "node scripts/screenshot/sync-docs.mjs",
    "screenshot:docs:check": "node scripts/screenshot/sync-docs.mjs --check",
    "service-qa": "npm run service-qa --prefix web",
    "service-qa:up": "node scripts/cloud/up.mjs",
    "service-qa:contracts": "npm run service-qa:contracts --prefix web",
    "service-qa:ui": "npm run service-qa:ui --prefix web",
    "service-qa:deno": "node scripts/cloud/deno-test.mjs",
    "web-qa": "npm run test:web-qa --prefix web",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:ast": "ast-grep scan --warning",
    "lint:ast:test": "ast-grep test",
    "lint": "oxlint . && eslint . && npm run lint:ast"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@supabase/supabase-js": "^2.117.2",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@xyflow/react": "^12.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.38.7",
    "@biomejs/biome": "2.5.8",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.1.12",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react-swc": "^4.0.1",
    "axe-core": "^4.13.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "^26.1.0",
    "oxlint": "1.78.0",
    "playwright": "^1.55.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.67.0",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
