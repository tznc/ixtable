    {
      "id": "action/hierarchy",
      "title": "One primary per surface",
      "component": "ActionButton",
      "description": "A form footer, a danger confirm, and a row action.",
      "code": [
        {
          "text": "v_flex()\n    .gap_4()\n    .child(\n        h_flex()\n            .gap_2()\n            .child(ActionButton::quiet(\"help\", \"What's a relationship?\"))\n            .child(ActionButton::new(\"cancel\", \"Cancel\"))\n            .child(ActionButton::primary(\"create\", \"Create relationship\")),\n    )\n    .child(\n        h_flex()\n            .gap_2()\n            .child(ActionButton::new(\"keep\", \"Keep table\"))\n            .child(ActionButton::danger(\"delete\", \"Delete table\").confirm()),\n    )\n    .child(ActionButton::danger(\"row-delete\", \"Delete record\").small())"
        }
      ],
      "themes": [
        "light",
        "dark"
      ],
      "variants": [
        {
          "theme": "light",
          "key": "",
          "is_default": true,
          "file": "snapshots/action/hierarchy/light/default.png",
          "width": 464,
          "height": 157,
          "scale": 2.0,
