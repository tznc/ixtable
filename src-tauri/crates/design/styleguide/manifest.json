          "width": 464,
          "height": 157,
          "scale": 2.0,
          "hash": "603eeea48e0ad7ba"
        }
      ]
    },
    {
      "id": "page-header/playground",
      "title": "Playground",
      "component": "PageHeader",
      "code": [
        {
          "text": "div().w(px(640.)).child(\n    PageHeader::new(\"header\", \"Orders\")\n        .when("
        },
        {
          "knob": "breadcrumb"
        },
        {
          "text": ", |this| {\n            this.breadcrumb(\n                gpui_bootstrap::breadcrumb::Breadcrumb::new(\"crumbs\")\n                    .item(\"Northwind\", |_, _, _| {})\n                    .active(\"Orders\"),\n            )\n        })\n        .description("
        },
        {
          "knob": "description"
        },
        {
          "text": ")\n        .action(ActionButton::new(\"import\", \"Import records…\"))\n        .action(ActionButton::primary(\"new\", \"New order\")),\n)"
        }
      ],
      "knobs": [
