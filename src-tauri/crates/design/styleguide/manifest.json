    {
      "id": "callout/playground",
      "title": "Playground",
      "component": "Callout",
      "code": [
        {
          "text": "div().w(px(480.)).child(\n    Callout::new(\n        \"callout\",\n        knobs.pick(\"tone\", TONES, \"warning\"),\n        "
        },
        {
          "knob": "title"
        },
        {
          "text": ",\n    )\n    .body("
        },
        {
          "knob": "body"
        },
        {
          "text": ")\n    .when("
        },
        {
          "knob": "details"
        },
        {
          "text": ", |this| {\n        this.details(\"NOT NULL constraint failed: orders.ship_address\")\n    })\n    .when("
        },
        {
          "knob": "action"
        },
        {
          "text": ", |this| {\n        this.action(ActionButton::new(\"fix\", \"Show customers\").small())\n    }),\n)"
        }
      ],
      "knobs": [
        {
          "name": "tone",
          "type": "select",
          "options": [
            "neutral",
            "info",
            "success",
            "warning",
            "danger"
          ],
          "default": "warning"
        },
        {
          "name": "title",
          "type": "text",
          "samples": [
            "3 orders can't be shipped"
          ],
          "default": "3 orders can't be shipped"
        },
        {
          "name": "body",
          "type": "text",
          "samples": [
            "Their customers have no address. Add one, then try again."
