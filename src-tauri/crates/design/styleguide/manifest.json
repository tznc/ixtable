        {
          "text": ";\nActionButton::new(\n    \"action\",\n    "
        },
        {
          "knob": "label"
        },
        {
          "text": ",\n)\n.emphasis("
        },
        {
          "knob": "emphasis",
          "code": {
            "danger": "Emphasis::Danger",
            "primary": "Emphasis::Primary",
            "quiet": "Emphasis::Quiet",
            "secondary": "Emphasis::Secondary"
          }
        },
        {
          "text": ")\n.when(disabled, |this| {\n    this.disabled_because(\"Choose a file first\")\n})"
        }
