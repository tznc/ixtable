      "component": "Typography",
      "code": [
        {
          "text": "v_flex().gap_3().children(Type::ALL.map(|ty| {\n    h_flex()\n        .gap_4()\n        .items_baseline()\n        .child(div().w(px(80.)).ty(Type::Caption).child(ty.name()))\n        .child(div().ty(ty).child(\"Orders waiting to ship\"))\n}))"
