{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ixtable",
  "version": "0.1.0",
  "identifier": "com.ixtable.desktop",
  "build": {
    "frontendDist": []
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/duckdb/*/*.duckdb_extension.gz"
    ],
    "fileAssociations": [
      {
        "ext": [
          "ixt"
        ],
        "name": "ixtable Document",
        "description": "Portable ixtable database archive",
        "role": "Editor",
        "mimeType": "application/x-ixtable"
      },
      {
        "ext": [
          "ixtr"
        ],
        "name": "ixtable Runtime Bundle",
        "description": "Signed ixtable application bundle",
        "role": "Viewer",
        "mimeType": "application/x-ixtable-runtime"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "./entitlements.plist"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "linux": {
      "deb": {
        "section": "office"
      },
      "rpm": {
        "release": "1"
      }
    }
  }
}
